# =============================================================================
# eBay Sales Optimizer — environment configuration
# Copy to `.env` and fill in. NEVER commit the real .env (it is gitignored).
# No token or secret is ever printed to logs by this tool.
# =============================================================================

# ----- eBay application credentials (from developer.ebay.com > My Account >
#       Application Keysets). Use the Production keyset for real seller data. ---
EBAY_ENV=production                 # production | sandbox
EBAY_CLIENT_ID=your-app-id-here     # "App ID (Client ID)"
EBAY_CLIENT_SECRET=your-cert-id     # "Cert ID (Client Secret)"
EBAY_RU_NAME=your-runame-here       # OAuth redirect endpoint name (RuName)

# ----- User token (authorization-code grant). Obtained by running
#       `python scripts/check_auth.py` and completing the consent flow once.
#       Only the long-lived refresh token is stored here; access tokens are
#       short-lived and fetched on demand, never written to disk. -------------
EBAY_REFRESH_TOKEN=

# ----- Marketplace. This account sells on eBay Germany. --------------------
EBAY_MARKETPLACE_ID=EBAY_DE

# ----- Local storage. Default is a SQLite file under ./data/. ---------------
DATABASE_URL=sqlite:///data/optimizer.db
